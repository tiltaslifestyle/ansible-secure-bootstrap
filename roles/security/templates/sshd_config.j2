# {{ ansible_managed }}
#
# SSH Server Configuration
# Optimized for Security and Performance
#

# Basic Configuration
Include /etc/ssh/sshd_config.d/*.conf
Port {{ ssh_port | default('22') }}

# ==============================================================
# Authentication & Access Control
# ==============================================================

# Security: Disable root login completely
PermitRootLogin no

# Security: Limit maximum authentication attempts to prevent brute-force
MaxAuthTries 3

# Security: Public Key Authentication ONLY
PubkeyAuthentication yes
PasswordAuthentication no
PermitEmptyPasswords no
ChallengeResponseAuthentication no
KerberosAuthentication no
GSSAPIAuthentication no

# Security: Whitelist users (Strict Access Control)
AllowUsers {{ automation_user }}

# ==============================================================
# Network & Performance
# ==============================================================

# Performance: Disable DNS lookups to speed up login
UseDNS no

# Session Management: Disconnect idle/dead sessions after 10 minutes (300s * 2)
ClientAliveInterval 300
ClientAliveCountMax 2

# ==============================================================
# Attack Surface Reduction
# ==============================================================

# Security: Disable GUI forwarding 
X11Forwarding no

# Security: Disable Agent forwarding unless explicitly needed
AllowAgentForwarding no

# Security: Disable TCP forwarding unless needed for tunneling
# AllowTcpForwarding no 

# ==============================================================
# Misc
# ==============================================================

UsePAM yes
PrintMotd no
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/openssh/sftp-server